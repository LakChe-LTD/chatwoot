{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".claude/rules/lakchelink-ui.md"],
  "mcp": {
    "shadcn-vue": {
      "type": "local",
      "command": ["npx", "shadcn-vue@latest", "mcp"],
      "enabled": true
    },
    "browser": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
